# Maintenance
MAINTENANCE_MODE=false

# Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL_DEV=http://localhost:3000
NEXT_PUBLIC_SITE_URL_PROD=https://heartinmotionhk.com

# Node
NODE_ENV=development

# Payload Server
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL_DEV=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL_PROD=https://heartinmotionhk.com
PAYLOAD_SECRET=change-me-to-a-random-32-char-string

# Domain
NEXT_PUBLIC_DOMAIN=localhost:3000
NEXT_PUBLIC_DOMAIN_DEV=localhost:3000
NEXT_PUBLIC_DOMAIN_PROD=heartinmotionhk.com

# Database (SQLite)
DATABASE_URL=file:./data/payload.db

# Media
PAYLOAD_MEDIA_DIR=./public/media
NEXT_PUBLIC_MEDIA_URL=/media

# Email (AWS SES SMTP)
AWS_SES_SMTP_HOST=email-smtp.ap-east-1.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=your-ses-iam-user
AWS_SES_SMTP_PASSWORD=your-ses-smtp-password
EMAIL_FROM=noreply@heartinmotionhk.com
EMAIL_FROM_NAME=Heart in Motion HK

# Revalidation (random secret for Next.js ISR)
REVALIDATE_SECRET=change-me-to-a-random-string
