{
  "name": "heartinmotionhk-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npm run generate:importmap",
    "postinstall": "npm run generate:types && npm run generate:importmap",
    "start": "next start",
    "start:prod": "npm run build && npm run start",
    "lint": "next lint",
    "generate:types": "NODE_OPTIONS='--import tsx' payload generate:types",
    "generate:importmap": "NODE_OPTIONS='--import tsx' payload generate:importmap",
    "payload": "NODE_OPTIONS='--import tsx' payload",
    "migrate:create": "NODE_OPTIONS='--import tsx' payload migrate:create",
    "migrate": "NODE_OPTIONS='--import tsx' payload migrate",
    "clean": "rm -rf .next node_modules",
    "rebuild": "rm -rf .next node_modules && next build",
    "redb": "NODE_OPTIONS='--import tsx' payload migrate:create && NODE_OPTIONS='--import tsx' payload migrate",
    "regen": "NODE_OPTIONS='--import tsx' payload generate:types && NODE_OPTIONS='--import tsx' payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.33.0",
    "@payloadcms/email-nodemailer": "3.33.0",
    "@payloadcms/next": "3.33.0",
    "@payloadcms/plugin-form-builder": "3.33.0",
    "@payloadcms/plugin-import-export": "3.33.0",
    "@payloadcms/plugin-nested-docs": "3.33.0",
    "@payloadcms/plugin-redirects": "3.33.0",
    "@payloadcms/plugin-search": "3.33.0",
    "@payloadcms/plugin-seo": "3.33.0",
    "@payloadcms/richtext-lexical": "3.33.0",
    "@payloadcms/ui": "3.33.0",
    "embla-carousel-autoplay": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "graphql": "^16.13.2",
    "lucide-react": "^0.400.0",
    "next": "15.5.15",
    "next-intl": "^3.0.0",
    "nodemailer": "^6.9.16",
    "payload": "3.33.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "ignore-loader": "^0.1.2",
    "postcss": "^8.0.0",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "sharp": "^0.34.0"
  }
}
